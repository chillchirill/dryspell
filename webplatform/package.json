{
  "name": "dryspell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx apps/server/src/index.ts",
    "worker": "node apps/server/dist/worker.js",
    "build": "vite build --config apps/web/vite.config.ts && node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx apps/server/src/migrate.ts",
    "db:seed": "tsx apps/server/src/seed.ts",
    "start": "node apps/server/dist/index.js",
    "verify:stack": "tsx scripts/verify-stack.ts",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "train": "tsx packages/inference/src/train-cli.ts",
    "build:server": "node scripts/build-server.mjs",
    "sandbox:build": "vite build --config apps/sandbox/vite.config.ts && node scripts/build-sandbox.mjs",
    "sandbox:start": "node apps/sandbox/dist-server/index.js",
    "sandbox:dev": "tsx apps/sandbox/server/index.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@turf/turf": "^7.2.0",
    "compression": "^1.8.2",
    "dotenv": "^17.2.0",
    "echarts": "^6.0.0",
    "express": "^5.1.0",
    "geotiff": "^3.0.5",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.18.0",
    "pg": "^8.16.3",
    "pngjs": "^7.0.0",
    "proj4": "^2.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.1.0"
  }
}
