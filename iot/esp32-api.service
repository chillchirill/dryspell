[Unit]
Description=ESP32 HTTP API and WebSocket log stream (port 2500)
After=network.target
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=/opt/esp32-api
ExecStart=/usr/bin/node /opt/esp32-api/server.js
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=esp32-api
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/esp32-api/logs

[Install]
WantedBy=multi-user.target
